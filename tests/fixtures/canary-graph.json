{
  "schemaVersion": 1,
  "id": "wf_canary",
  "name": "Canary 工作流",
  "description": "Adapter 验收图",
  "revision": 0,
  "nodes": [
    {
      "id": "node_trigger",
      "type": "trigger",
      "name": "接收请求",
      "description": "接收外部请求并创建 requestId",
      "position": {
        "x": 0,
        "y": 120
      },
      "ports": [
        {
          "id": "main.out",
          "label": "Main",
          "kind": "main",
          "direction": "output",
          "required": true,
          "maxConnections": null
        }
      ],
      "config": {
        "trigger": "webhook",
        "authPolicy": "urtoris-token"
      }
    },
    {
      "id": "node_route",
      "type": "condition",
      "name": "是否高优先级",
      "description": "按表达式选择 true / false 分支",
      "position": {
        "x": 240,
        "y": 120
      },
      "ports": [
        {
          "id": "main.in",
          "label": "Main",
          "kind": "main",
          "direction": "input",
          "required": true,
          "maxConnections": 1
        },
        {
          "id": "branch.true",
          "label": "true",
          "kind": "branch",
          "direction": "output",
          "required": true,
          "maxConnections": null
        },
        {
          "id": "branch.false",
          "label": "false",
          "kind": "branch",
          "direction": "output",
          "required": true,
          "maxConnections": null
        }
      ],
      "config": {
        "expression": "$json.priority === \"high\""
      }
    },
    {
      "id": "node_agent",
      "type": "aiAgent",
      "name": "AI 主管",
      "description": "调用模型、记忆与工具完成任务",
      "position": {
        "x": 520,
        "y": 60
      },
      "ports": [
        {
          "id": "main.in",
          "label": "Main",
          "kind": "main",
          "direction": "input",
          "required": true,
          "maxConnections": 1
        },
        {
          "id": "main.out",
          "label": "Main",
          "kind": "main",
          "direction": "output",
          "required": false,
          "maxConnections": null
        },
        {
          "id": "resource.model",
          "label": "Model",
          "kind": "model",
          "direction": "output",
          "required": true,
          "maxConnections": 1
        },
        {
          "id": "resource.memory",
          "label": "Memory",
          "kind": "memory",
          "direction": "output",
          "required": false,
          "maxConnections": 1
        },
        {
          "id": "resource.tools",
          "label": "Tools",
          "kind": "tool",
          "direction": "output",
          "required": false,
          "maxConnections": null
        }
      ],
      "config": {
        "strategy": "tools",
        "instructions": "理解请求，必要时调用工具，并返回结构化结果。",
        "prompt": "$json.message",
        "maxIterations": 6,
        "fallbackPolicy": "rules"
      }
    },
    {
      "id": "node_model",
      "type": "llmModel",
      "name": "Qwen Plus",
      "description": "OpenAI-compatible chat model",
      "position": {
        "x": 520,
        "y": 320
      },
      "ports": [
        {
          "id": "model.provider",
          "label": "Model",
          "kind": "model",
          "direction": "input",
          "required": false,
          "maxConnections": 1
        }
      ],
      "config": {
        "provider": "openai-compatible",
        "model": "qwen-plus"
      }
    },
    {
      "id": "node_memory",
      "type": "memory",
      "name": "会话记忆",
      "description": "按 sessionId 保存最近对话",
      "position": {
        "x": 760,
        "y": 320
      },
      "ports": [
        {
          "id": "memory.provider",
          "label": "Memory",
          "kind": "memory",
          "direction": "input",
          "required": false,
          "maxConnections": 1
        }
      ],
      "config": {
        "provider": "window",
        "maxTurns": 12
      }
    },
    {
      "id": "node_tool",
      "type": "tool",
      "name": "订单查询",
      "description": "供 Agent 调用的受控工具",
      "position": {
        "x": 1000,
        "y": 320
      },
      "ports": [
        {
          "id": "tool.provider",
          "label": "Tool",
          "kind": "tool",
          "direction": "input",
          "required": false,
          "maxConnections": 1
        }
      ],
      "config": {
        "implementation": "http",
        "url": "https://api.example.com/orders",
        "method": "GET",
        "timeoutMs": 15000,
        "confirmation": "on-risk"
      }
    },
    {
      "id": "node_robot",
      "type": "robotAction",
      "name": "机器人指令",
      "description": "把已校验指令发送给比赛机器人",
      "position": {
        "x": 800,
        "y": 60
      },
      "ports": [
        {
          "id": "main.in",
          "label": "Main",
          "kind": "main",
          "direction": "input",
          "required": true,
          "maxConnections": 1
        },
        {
          "id": "main.out",
          "label": "Main",
          "kind": "main",
          "direction": "output",
          "required": false,
          "maxConnections": null
        }
      ],
      "config": {
        "action": "dispatch",
        "endpoint": "http://robot.local/command",
        "confirmation": "on-risk"
      }
    },
    {
      "id": "node_http",
      "type": "httpRequest",
      "name": "通知上游",
      "description": "调用白名单中的外部 API",
      "position": {
        "x": 520,
        "y": 560
      },
      "ports": [
        {
          "id": "main.in",
          "label": "Main",
          "kind": "main",
          "direction": "input",
          "required": true,
          "maxConnections": 1
        },
        {
          "id": "main.out",
          "label": "Main",
          "kind": "main",
          "direction": "output",
          "required": false,
          "maxConnections": null
        }
      ],
      "config": {
        "method": "POST",
        "url": "https://api.example.com/notify",
        "timeoutMs": 15000
      }
    },
    {
      "id": "node_out",
      "type": "output",
      "name": "返回结果",
      "description": "归一化并返回工作流结果",
      "position": {
        "x": 1080,
        "y": 60
      },
      "ports": [
        {
          "id": "main.in",
          "label": "Main",
          "kind": "main",
          "direction": "input",
          "required": true,
          "maxConnections": null
        }
      ],
      "config": {
        "envelope": "urtoris.v1"
      }
    }
  ],
  "edges": [
    {
      "id": "edge_node_trigger_main_out_node_route_main_in",
      "kind": "main",
      "source": {
        "nodeId": "node_trigger",
        "portId": "main.out"
      },
      "target": {
        "nodeId": "node_route",
        "portId": "main.in"
      }
    },
    {
      "id": "edge_node_route_branch_true_node_agent_main_in",
      "kind": "branch",
      "source": {
        "nodeId": "node_route",
        "portId": "branch.true"
      },
      "target": {
        "nodeId": "node_agent",
        "portId": "main.in"
      },
      "label": "true",
      "condition": {
        "branch": "true"
      }
    },
    {
      "id": "edge_node_route_branch_false_node_http_main_in",
      "kind": "branch",
      "source": {
        "nodeId": "node_route",
        "portId": "branch.false"
      },
      "target": {
        "nodeId": "node_http",
        "portId": "main.in"
      },
      "label": "false",
      "condition": {
        "branch": "false"
      }
    },
    {
      "id": "edge_node_agent_main_out_node_robot_main_in",
      "kind": "main",
      "source": {
        "nodeId": "node_agent",
        "portId": "main.out"
      },
      "target": {
        "nodeId": "node_robot",
        "portId": "main.in"
      }
    },
    {
      "id": "edge_node_http_main_out_node_out_main_in",
      "kind": "main",
      "source": {
        "nodeId": "node_http",
        "portId": "main.out"
      },
      "target": {
        "nodeId": "node_out",
        "portId": "main.in"
      }
    },
    {
      "id": "edge_node_robot_main_out_node_out_main_in",
      "kind": "main",
      "source": {
        "nodeId": "node_robot",
        "portId": "main.out"
      },
      "target": {
        "nodeId": "node_out",
        "portId": "main.in"
      }
    },
    {
      "id": "edge_node_agent_resource_model_node_model_model_provider",
      "kind": "model",
      "source": {
        "nodeId": "node_agent",
        "portId": "resource.model"
      },
      "target": {
        "nodeId": "node_model",
        "portId": "model.provider"
      }
    },
    {
      "id": "edge_node_agent_resource_memory_node_memory_memory_provider",
      "kind": "memory",
      "source": {
        "nodeId": "node_agent",
        "portId": "resource.memory"
      },
      "target": {
        "nodeId": "node_memory",
        "portId": "memory.provider"
      }
    },
    {
      "id": "edge_node_agent_resource_tools_node_tool_tool_provider",
      "kind": "tool",
      "source": {
        "nodeId": "node_agent",
        "portId": "resource.tools"
      },
      "target": {
        "nodeId": "node_tool",
        "portId": "tool.provider"
      }
    }
  ],
  "entryNodeIds": [
    "node_trigger"
  ],
  "runtime": {
    "engine": "n8n",
    "adapter": "n8n-v1",
    "executionMode": "webhook",
    "binding": "draft"
  },
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 0.82
  },
  "metadata": {
    "source": "urtoris",
    "updatedAt": 0
  }
}
