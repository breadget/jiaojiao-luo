{
  "name": "02 - Security Analysis: IP/URL Triage",
  "id": "wf020000-0000-4000-8000-000000000002",
  "nodes": [
    {
      "parameters": {
        "event": "issues",
        "issues": "opened",
        "repo": "your-org/your-repo",
        "authentication": "oAuth2"
      },
      "id": "f2a20001-0000-4000-8000-000000000001",
      "name": "On new issue",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "jsCode": "// Extract IP addresses and domains from the issue body.\n// Keeps a flat array per item so it can fan out to both scanners.\nconst body = $json.body || $json.issue?.body || '';\n\nconst ipRegex = /\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b/g;\nconst domainRegex = /\\b(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}\\b/g;\n\nconst ips = [...new Set(body.match(ipRegex) || [])];\nconst domains = [...new Set(body.match(domainRegex) || [])];\n\nreturn { json: { ...$json, ips, domains, issueNumber: $json.issue?.number || $json.number } };\n"
      },
      "id": "f2a20002-0000-4000-8000-000000000002",
      "name": "Extract IPs and domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.virustotal.com/api/v3/urls",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-apikey", "value": "=YOUR_VIRUSTOTAL_API_KEY" },
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            { "name": "url", "value": "={{ $json.domains[0] }}" }
          ]
        },
        "options": {}
      },
      "id": "f2a20003-0000-4000-8000-000000000003",
      "name": "VirusTotal: Scan URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.virustotal.com/api/v3/analyses/={{ $json.data.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-apikey", "value": "=YOUR_VIRUSTOTAL_API_KEY" }
          ]
        },
        "options": {}
      },
      "id": "f2a20004-0000-4000-8000-000000000004",
      "name": "VirusTotal: Get Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, -260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://urlscan.io/api/v1/scan/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "API-Key", "value": "=YOUR_URLSCAN_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"url\": $json.domains[0], \"visibility\": \"public\" }",
        "options": {}
      },
      "id": "f2a20005-0000-4000-8000-000000000005",
      "name": "urlscan.io",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, 260]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "f2a20006-0000-4000-8000-000000000006",
      "name": "Merge reports",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [620, 0]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "update",
        "repository": "your-org/your-repo",
        "issueNumber": "={{ $('On new issue').first().json.issue.number }}",
        "body": "=## Security triage results\n\n{{ $json | dump }}"
      },
      "id": "f2a20007-0000-4000-8000-000000000007",
      "name": "Post results",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [860, 0]
    }
  ],
  "connections": {
    "On new issue": {
      "main": [[{ "node": "Extract IPs and domains", "type": "main", "index": 0 }]]
    },
    "Extract IPs and domains": {
      "main": [
        [{ "node": "VirusTotal: Scan URL", "type": "main", "index": 0 }],
        [{ "node": "urlscan.io", "type": "main", "index": 0 }]
      ]
    },
    "VirusTotal: Scan URL": {
      "main": [[{ "node": "VirusTotal: Get Report", "type": "main", "index": 0 }]]
    },
    "VirusTotal: Get Report": {
      "main": [[{ "node": "Merge reports", "type": "main", "index": 0 }]]
    },
    "urlscan.io": {
      "main": [[{ "node": "Merge reports", "type": "main", "index": 1 }]]
    },
    "Merge reports": {
      "main": [[{ "node": "Post results", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "a2000000-0000-4000-8000-000000000001",
  "meta": { "templateCredsSetupCompleted": true },
  "pinData": {},
  "tags": []
}
