    {
      "parameters": {
        "promptType": "define",
        "text": "You are a Proxmox API assistant. Given an incoming request (mode and payload), decide the correct Proxmox API action.\n\nUse the tools to:\n- Look up the Proxmox API documentation for the requested endpoint.\n- Perform the requested action against the Proxmox server.\n\nOutput a short summary and the resulting HTTP method (GET / POST / DELETE).",
        "options": {}
      },
      "id": "f3a20002-0000-4000-8000-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "leftValue": "={{ $json.method || 'GET' }}", "rightValue": "GET", "operator": { "type": "string", "operation": "equals" } } },
            { "conditions": { "leftValue": "={{ $json.method || 'GET' }}", "rightValue": "POST", "operator": { "type": "string", "operation": "equals" } } },
            { "conditions": { "leftValue": "={{ $json.method || 'GET' }}", "rightValue": "DELETE", "operator": { "type": "string", "operation": "equals" } } }
          ]
        },
        "options": {}
      },
      "id": "f3a20003-0000-4000-8000-000000000003",
      "name": "Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [200, 0]
    },
