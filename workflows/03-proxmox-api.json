      "id": "f3a20004-0000-4000-8000-000000000004",
      "name": "Get properties",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, -300]
    },
    {
      "parameters": {
        "jsCode": "// Shape the fetched properties into a predictable response.\nreturn { json: { success: true, type: 'properties', data: Object.keys($json).map((k) => ({ key: k, value: $json[k] })) } };\n"
      },
      "id": "f3a20005-0000-4000-8000-000000000005",
      "name": "Structure Response",
