{
  "name": "01 - Create User: AI Manager Agent",
  "id": "wf010000-0000-4000-8000-000000000001",
  "nodes": [
    {
      "parameters": {
        "title": "On 'Create User' form submission",
        "description": "A new user joined. Fill in the details and the AI agent will provision the user and their Slack access.",
        "fields": {
          "values": [
            { "fieldLabel": "Full name", "placeholder": "Jane Doe", "required": true, "type": "text", "fieldType": "text" },
            { "fieldLabel": "Work email", "placeholder": "jane@company.com", "required": true, "type": "email", "fieldType": "text" },
            { "fieldLabel": "Role / Title", "placeholder": "Engineering Manager", "required": true, "type": "text", "fieldType": "text" },
            { "fieldLabel": "Is a manager?", "required": true, "type": "select", "fieldType": "select", "selectOptions": [
              { "option": "Yes" }, { "option": "No" }
            ] }
          ]
        },
        "options": {
          "completionMessage": "User created and workspace access configured."
        }
      },
      "id": "f1a20001-0000-4000-8000-000000000001",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 1.1,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are an onboarding assistant. A form submission for a new user arrived with fields: name, email, role, and whether they are a manager.\n\nUse the provided tools to:\n1. Create the user in Microsoft Entra ID (and assign a role).\n2. Create the user in Jira Software.\n3. Output a summary of what you did, and clearly state whether the user is a manager.\n\nIf anything fails, add a warning to your summary.",
        "options": {}
      },
      "id": "f1a20002-0000-4000-8000-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-a",
              "leftValue": "={{ JSON.stringify($json).toLowerCase().includes('manager') ? 'true' : 'false' }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f1a20003-0000-4000-8000-000000000003",
      "name": "Is a manager?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [420, 0]
    },
    {
      "parameters": {
        "resource": "channel",
        "operation": "inviteToChannel",
        "channelId": { "__rl": true, "mode": "list", "value": "" },
        "userIds": { "__rl": true, "mode": "list", "value": "" }
      },
      "id": "f1a20004-0000-4000-8000-000000000004",
      "name": "Add to channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [860, -180]
    },
    {
      "parameters": {
        "resource": "user",
        "operation": "updateProfile",
        "profileFields": {
          "assignments": [
            { "id": "profileEmail", "name": "email", "type": "string", "value": "={{ $('AI Agent').item.json.email }}" },
            { "id": "profileName", "name": "displayName", "type": "string", "value": "={{ $('AI Agent').item.json.name }}" },
            { "id": "profileTitle", "name": "title", "type": "string", "value": "={{ $('AI Agent').item.json.role }}" }
          ]
        }
      },
      "id": "f1a20005-0000-4000-8000-000000000005",
      "name": "Update profile",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [860, 180]
    },
    {
      "parameters": {
