# 依赖
node_modules/

# 生成产物：由 tools/build-workflows.mjs 从 workflows/*.json 蓝图确定性重建。
# 不纳入版本控制；产物正确性由 tools/validate-workflows.mjs、
# tools/test-node-versions.mjs 与 tools/test-execution-binding.mjs 在每次部署前把关
# （deploy-n8n.mjs 会依次跑它们）。
generated/

# 机密：共享令牌（webhookToken / internalToken）自动生成在这里，绝不提交
.secrets.json
.env
.env.*
.dev.vars
.dev.vars.*

# 杂项
*.log
.DS_Store
