{
  "name": "urtoris-workflows",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:course": "bash scripts/course-dev.sh",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "test": "node --experimental-test-module-mocks --import tsx --import ./tests/helpers/loader-hooks.mjs --test \"tests/**/*.test.ts\"",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "dev:control": "bash scripts/local-control-dev.sh",
    "database:local": "node --import tsx services/database-bridge/main.ts",
    "control:local": "bash scripts/local-control.sh",
    "control:gate": "node --import tsx scripts/local-control-gate.ts",
    "control:stub-model": "node --import tsx scripts/local-control-stub-model.ts",
    "executor:dev": "node --import tsx services/python-executor/server.ts",
    "executor:local": "bash scripts/executor-local.sh",
    "executor:canary": "node --import tsx services/python-executor/canary.ts",
    "executor:gate:long": "node --import tsx scripts/executor-long-gate.ts",
    "executor:test:docker": "PYTHON_EXECUTOR_DOCKER_TEST=1 node --import tsx --test tests/python-executor-docker-integration.test.ts",
    "robot:bridge": "node --import tsx services/robot-bridge/server.ts",
    "ecs:site": "bash deploy/connect-ecs-site.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "workerd@1.20260515.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
