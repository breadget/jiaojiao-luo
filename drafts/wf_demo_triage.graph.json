      "kind": "branch",
      "label": "true",
      "condition": { "branch": "true" },
      "source": { "nodeId": "node_step_priority", "portId": "branch.true" },
      "target": { "nodeId": "node_human_escalation", "portId": "main.in" }
    },
    {
      "id": "edge_node_step_priority_branch_false_node_step_return_main_in",
      "kind": "branch",
      "label": "false",
      "condition": { "branch": "false" },
      "source": { "nodeId": "node_step_priority", "portId": "branch.false" },
      "target": { "nodeId": "node_step_return", "portId": "main.in" }
    },
    {
      "id": "edge_node_step_summary_resource_model_node_step_summary_model_model_provider",
      "kind": "model",
      "source": { "nodeId": "node_step_summary", "portId": "resource.model" },
      "target": { "nodeId": "node_step_summary_model", "portId": "model.provider" }
    },
    {
      "id": "edge_node_step_summary_resource_memory_node_step_summary_memory_memory_provider",
      "kind": "memory",
      "source": { "nodeId": "node_step_summary", "portId": "resource.memory" },
      "target": { "nodeId": "node_step_summary_memory", "portId": "memory.provider" }
    }
  ],
  "entryNodeIds": ["node_step_intake"],
  "runtime": {
