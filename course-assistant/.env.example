# Copy to .env; fill your provider key locally. Never commit .env.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DJANGO_SECRET_KEY=
TIME_ZONE=Asia/Seoul

# OpenAI-compatible chat endpoint (Qwen example). Model and endpoint must match.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# Default: real local Chinese semantic embeddings; no API key needed.
# First indexing downloads the model; subsequent queries use the local cache.
RAG_EMBEDDING_BACKEND=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# If using an embeddings API instead, set backend=openai and its own model/key.
# The chat model is not an embedding model.
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
RAG_TOP_K=4
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=100
RAG_MIN_SCORE=0.45
RAG_TIMEOUT=60
